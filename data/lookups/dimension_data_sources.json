  {
    "lens": "local_social",
    "dimension": "housing",
    "category": "Healthy",
    "indicator": "% non-decent homes",
    "source_url": "https://www.gov.uk/government/collections/english-housing-survey-local-authority-stock-condition-modelling",
    "granularity": "Local authority (modelled)",
    "notes": "MHCLG modelled estimates of Decent Homes Standard failure by local authority, produced from English Housing Survey stock data (https://www.gov.uk/government/collections/english-housing-survey). Releases: 2019, 2020, 2023, 2024 (no round in 2021/2022). Official guidance cautions against directly comparing LA estimates across releases due to methodology changes between rounds - treat the trend as indicative rather than a precise time series."
  },
  {
    "lens": "local_social",
    "dimension": "food",
    "category": "Healthy",
    "indicator": "% population with moderate to severe food insecurity",
    "source_url": "https://fingertips.phe.org.uk/profile/wider-determinants/data#page/6/gid/1938133045/pat/501/par/E92000001/ati/501/are/E09000023/iid/93864/age/1/sex/4/cat/-1/ctp/-1/yrr/1/cid/4/tbm/1",
    "granularity": "Local Authority",
    "notes": "OHID Fingertips indirect food insecurity risk measure (borough level). Underlying source: DWP Family Resources Survey small-area model. Corroborated by Lewisham Council's Food Justice Action Plan Update (Jan 2026). Previously sourced from the Food Foundation's Health and Diet Inequalities Dashboard (constituency-level modelled estimate, foodfoundation.org.uk/initiatives/health-and-diet-inequalities-dashboard) - switched to the primary Fingertips data it is itself modelled from, per DIMENSION_PAGE_SPECIFICATION.md 1.4."
  },
  {
    "lens": "local_social",
    "dimension": "food",
    "category": "Healthy",
    "indicator": "% of children in reception and year 6 with obesity",
    "source_url": "https://fingertips.phe.org.uk/profile/national-child-measurement-programme",
    "granularity": "Local Authority",
    "notes": "NHS Digital National Child Measurement Programme (NCMP) via OHID Fingertips (borough level, indicators 90319 Reception + 90323 Year 6). Previously sourced from the Food Foundation's Health and Diet Inequalities Dashboard (constituency-level modelled estimate) - switched to the primary NCMP data per DIMENSION_PAGE_SPECIFICATION.md 1.4."
  },
  {
    "lens": "local_social",
    "dimension": "food",
    "category": "Healthy",
    "indicator": "% of children in reception and year 6 with dental decay",
    "source_url": "https://fingertips.phe.org.uk/profile/child-health-profiles",
    "granularity": "Local Authority",
    "notes": "OHID National Dental Epidemiology Programme (NDEP) oral health surveys of 5-year-olds (biennial) and Year 6 children (surveyed once, 2022/23) - borough level. Previously sourced from the Food Foundation's Health and Diet Inequalities Dashboard (constituency-level modelled estimate) - switched to the primary NDEP survey data per DIMENSION_PAGE_SPECIFICATION.md 1.4."
  },
  {
    "lens": "local_social",
    "dimension": "food",
    "category": "Healthy",
    "indicator": "% of people over 17 years old with type 2 diabetes",
    "source_url": "https://fingertips.phe.org.uk/profile/diabetes-ft",
    "granularity": "Local Authority",
    "notes": "OHID Fingertips Diabetes Profile QOF prevalence, age 17+ (borough level, indicator 241) - records all diagnosed diabetes (type 1 and type 2); type 2 is ~90% of diagnosed cases nationally. A type-2-only measure exists only at South East London ICB level (indicator 94177). Previously sourced from the Food Foundation's Health and Diet Inequalities Dashboard (constituency-level modelled estimate) - switched to the primary Fingertips data per DIMENSION_PAGE_SPECIFICATION.md 1.4."
  },
  {
    "lens": "local_social",
    "dimension": "water_and_sanitation",
    "category": "Healthy",
    "indicator": "Per capita water consumption (litres/day)",
    "source_url": "https://www.gov.uk/government/publications/water-resources-2024-2025-analysis-of-the-water-industrys-annual-water-resources-performance/water-resources-2024-to-2025-analysis-of-the-water-industrys-annual-water-resources-performance",
    "granularity": "National (England)",
    "notes": "Renamed from 'Per household water consumption' - the WRMP Annual Review Data (data.gov.uk) this indicator originally pointed to is per capita consumption (PCC) by water company, not per household. Company-level (Thames Water) and Lewisham-specific figures are not separately published; England-wide PCC is used, corroborated by Thames Water's own qualitative performance reporting and by GLA London-wide consumption figures (see source notes in build_local_social_with_real_data.py)."
  },
  {
    "lens": "local_social",
    "dimension": "water_and_sanitation",
    "category": "Healthy",
    "indicator": "Areas of water stress",
